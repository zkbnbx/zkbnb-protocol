# ---- chain ------------------------------------------------------------------
RPC_URL=https://bsc-testnet-rpc.publicnode.com
CHAIN_ID=97
# the address of this key must equal HolderRewards.keeper() for `rewards`; every other
# command is permissionless. Leave empty with DRY_RUN=1 to only simulate.
KEEPER_PRIVATE_KEY=
# defaults to ../contracts/deployments/<CHAIN_ID>.json
DEPLOYMENTS_PATH=

# ---- thresholds (BNB) ---------------------------------------------------------
MIN_SWEEP_BNB=0.02
# empty = read HolderRewards.minPot() on-chain
MIN_POT_BNB=
MIN_HOLDING_USD=20
# fallback when api.binance.com is unreachable
BNB_USD=
MIN_BUYBACK_BNB=0.05

# ---- snapshots -----------------------------------------------------------------
SNAPSHOT_DIR=./snapshots
# public prefix that serves SNAPSHOT_DIR, e.g. https://grove.example/snapshots
# (the on-chain uri becomes <prefix>/<coin>/<runId>.json)
SNAPSHOT_BASE_URL=
# optional: upload snapshot JSON to Vercel Blob; the blob URL then becomes the uri
BLOB_READ_WRITE_TOKEN=
# extra addresses to exclude from holder snapshots (comma separated)
EXCLUDE_ADDRESSES=

# ---- scanning -------------------------------------------------------------------
LOG_CHUNK=2000
# blocks behind head treated as final for caches
CONFIRMATIONS=20
FEED_DAYS=30

# ---- runtime ----------------------------------------------------------------------
KEEPER_INTERVAL_SEC=300
# 1 = simulateContract only, never send
DRY_RUN=
# debug | info | warn | error
LOG_LEVEL=info

# Upper bound in seconds of the random delay before a holder snapshot (default 3600 = within the hour). Lower only for testing.
SNAPSHOT_DELAY_MAX_SEC=3600

# ---- privacy stage 2 (read only by coordinator / rotate-key / pool-feed / dividends / flush; all inert while
# ---- grovePool / darkCurve / planter are absent from the deployment file) ------------------------------------
# Coordinator key: production keeps keys ONLY in COORDINATOR_KEY_DIR (written by rotate-key, mode 0600).
# COORDINATOR_SK (decimal or 0x-hex scalar below the subgroup order) is for a single-key testnet/local setup.
COORDINATOR_KEY_DIR=./snapshots/coordinator-keys
COORDINATOR_SK=
# openEpoch through a private-transaction RPC (48 Club / bloXroute); empty = public RPC, logged as a warning
PRIVATE_TX_RPC=
# minOut = quote * (1 - SLIPPAGE_BPS / 1e4)
SLIPPAGE_BPS=300
# consecutive failed open attempts before a direction is left to the void
MAX_OPEN_ATTEMPTS=3
# epochOpen artifacts (DEV keys until the ceremony, circuits/CEREMONY-v2.md)
OPEN_WASM=../circuits/build/epochOpen.wasm
OPEN_ZKEY=../circuits/build/epochOpen.zkey
OPEN_VKEY=../circuits/build/verification_key_epochOpen.json
# BSGS table (2^24: built once, about 3 min, 128 MB on disk); default SNAPSHOT_DIR/bsgs-<BSGS_BITS>.bin
BSGS_BITS=24
BSGS_PATH=
# rotate-key: minimum seconds between proposals, and switchAt = now + ROTATE_LEAD_SEC
ROTATE_EVERY_SEC=86400
ROTATE_LEAD_SEC=3600
# pool-feed: local bundle root (default SNAPSHOT_DIR/pool), bundle rebuild period, blocks treated as final
POOL_FEED_DIR=
POOL_FEED_BUNDLE_SEC=60
POOL_FEED_CONFIRMATIONS=3
# flush: CreatorStub.flush() when balance + FeeRouter.pending >= this
MIN_FLUSH_BNB=0.01
# dividends: latest runs per Holders coin checked per pass
DIVIDENDS_LOOKBACK=5

# ---- stage-2 relayer (`relayer` command / pm2 app grove-relayer; a DIFFERENT HOST from the coordinator) ----
# On chain 56 the relayer refuses to start if COORDINATOR_SK / COORDINATOR_KEY_DIR are set in its environment, and
# coordinator / rotate-key refuse if RELAYER_PRIVATE_KEY / RELAYER_HELD_KEY are (keeper/src/roles.ts): separate .env files.
# Its own wallet; KEEPER_PRIVATE_KEY is never used by the relayer. Empty = refuse to start (or --dry-run: ephemeral key, never sends)
RELAYER_PRIVATE_KEY=
RELAYER_HOST=127.0.0.1
RELAYER_PORT=8788
# comma-separated browser origins allowed by CORS; requests without an Origin header (curl, Tor) are always served
RELAYER_ALLOWED_ORIGINS=https://zkbnb.app
# behind ONE nginx / Tor proxy on the same host: take the client IP (rate limit only) from the LAST X-Forwarded-For
# hop, the one that proxy appends (proxy_add_x_forwarded_for); earlier hops are client-written and ignored
RELAYER_TRUST_PROXY=0
# POSTs are refused (503 busy) while this many sends are queued; held releases are never refused
RELAYER_MAX_QUEUE=32
# fee = smallest tier >= gasPrice * gasUnits * (1 + RELAY_MARGIN_BPS/1e4) + RELAY_FLAT_FEE_WEI
RELAY_FLAT_FEE_WEI=0
RELAY_MARGIN_BPS=2000
# stage-2 gas units per kind (written by contracts/scripts/gas-v2.mjs); default ../contracts/gas-v2.json
GAS_UNITS_FILE=
# 32-byte hex AES-GCM key for held requests at rest (hold / notBefore); empty = holds refused
RELAYER_HELD_KEY=
# encrypted held requests (default SNAPSHOT_DIR/relayer-held)
RELAYER_HELD_DIR=
RELAYER_HOLD_POLL_SEC=5
RELAYER_CHECKPOINT_SEC=60
# per-IP token buckets: quotes / status reads, and submissions (tokens per second, burst)
RELAYER_QUOTE_RATE=5
RELAYER_QUOTE_BURST=20
RELAYER_SUBMIT_RATE=0.2
RELAYER_SUBMIT_BURST=3
# optional: Tor hidden service directory (its `hostname` file is logged at start)
TOR_HIDDEN_SERVICE_DIR=
