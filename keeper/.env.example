# ---- chain ------------------------------------------------------------------
RPC_URL=https://bsc-testnet-rpc.publicnode.com
CHAIN_ID=97
# the address of this key must equal HolderRewards.keeper() for `rewards`; every other
# command is permissionless. Leave empty with DRY_RUN=1 to only simulate.
KEEPER_PRIVATE_KEY=
# defaults to ../contracts/deployments/<CHAIN_ID>.json
DEPLOYMENTS_PATH=

# ---- thresholds (BNB) ---------------------------------------------------------
MIN_SWEEP_BNB=0.02
# empty = read HolderRewards.minPot() on-chain
MIN_POT_BNB=
MIN_HOLDING_USD=20
# fallback when api.binance.com is unreachable
BNB_USD=
MIN_BUYBACK_BNB=0.05

# ---- snapshots -----------------------------------------------------------------
SNAPSHOT_DIR=./snapshots
# public prefix that serves SNAPSHOT_DIR, e.g. https://grove.example/snapshots
# (the on-chain uri becomes <prefix>/<coin>/<runId>.json)
SNAPSHOT_BASE_URL=
# optional: upload snapshot JSON to Vercel Blob; the blob URL then becomes the uri
BLOB_READ_WRITE_TOKEN=
# extra addresses to exclude from holder snapshots (comma separated)
EXCLUDE_ADDRESSES=

# ---- scanning -------------------------------------------------------------------
LOG_CHUNK=2000
# blocks behind head treated as final for caches
CONFIRMATIONS=20
FEED_DAYS=30

# ---- runtime ----------------------------------------------------------------------
KEEPER_INTERVAL_SEC=300
# 1 = simulateContract only, never send
DRY_RUN=
# debug | info | warn | error
LOG_LEVEL=info

# Upper bound in seconds of the random delay before a holder snapshot (default 3600 = within the hour). Lower only for testing.
SNAPSHOT_DELAY_MAX_SEC=3600
