# dependencies
node_modules/

# foundry
contracts/out/
contracts/cache/
contracts/broadcast/
out/
cache/
broadcast/

# environment and secrets: never commit
.env
.env.*
!.env.example
keys.txt

# circuit build outputs (large or reproducible). Only these are tracked:
#   circuits/build/verification_key.json
#   circuits/build/CEREMONY-HASHES.txt
#   circuits/build/transaction.wasm
*.zkey
*.ptau
circuits/build/*
!circuits/build/verification_key.json
!circuits/build/CEREMONY-HASHES.txt
!circuits/build/transaction.wasm

# keeper runtime
keeper/dist/
keeper/snapshots/
keeper/deployments.json

# misc
*.log
*.tmp
.DS_Store
